{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["intent_type", "entities", "confidence"],
  "properties": {
    "intent_type": {
      "type": "string",
      "enum": [
        "read_email",
        "draft_email",
        "create_calendar_event",
        "read_calendar",
        "detect_subscriptions"
      ]
    },
    "entities": {
      "type": "object",
      "properties": {
        "email_address": { "type": "string" },
        "person": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "subject": { "type": "string" }
      },
      "additionalProperties": false
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rejection_reason": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false
}
