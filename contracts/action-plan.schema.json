{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["steps", "plan_valid"],
  "properties": {
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "action_type",
          "target_service",
          "reversible",
          "requires_confirmation"
        ],
        "properties": {
          "action_type": {
            "type": "string",
            "enum": [
              "gmail_read",
              "gmail_draft",
              "calendar_read",
              "calendar_create"
            ]
          },
          "target_service": {
            "type": "string",
            "enum": ["gmail", "google_calendar"]
          },
          "reversible": {
            "type": "boolean"
          },
          "requires_confirmation": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "plan_valid": {
      "type": "boolean"
    },
    "failure_reason": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false
}
